# -----------------------------------------------------------------------------
# Plantilla de variables de entorno.
# Copiar a `.env` y completar con valores reales. NUNCA commitear `.env`.
# -----------------------------------------------------------------------------

# Entorno de ejecución
NODE_ENV=development
LOG_LEVEL=info

# --- Telegram -----------------------------------------------------------------
# Token entregado por @BotFather.
TELEGRAM_BOT_TOKEN=

# --- Base de datos (Supabase / Neon) ------------------------------------------
# Connection string PostgreSQL. En Supabase/Neon usar el pooler y sslmode=require.
# Ej.: postgresql://user:password@host:5432/postgres?sslmode=require
DATABASE_URL=
# TLS de la conexión (true para Supabase/Neon; false para Postgres local sin TLS).
DATABASE_SSL=true
# Tamaño máximo del pool de conexiones.
DATABASE_POOL_MAX=10

# --- Groq (transcripción de audio, Whisper) -----------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3

# --- OpenRouter (visión / extracción de tickets, Qwen2.5-VL) ------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=qwen/qwen-2.5-vl-72b-instruct

# --- Razonamiento (texto -> gasto estructurado) -------------------------------
# Cualquier API compatible con OpenAI. Por defecto Groq (plan gratuito).
# Para DeepSeek: REASONING_BASE_URL=https://api.deepseek.com/v1
#                REASONING_MODEL=deepseek-chat
#                REASONING_API_KEY=<key de DeepSeek>
REASONING_PROVIDER=groq
REASONING_API_KEY=
REASONING_BASE_URL=https://api.groq.com/openai/v1
REASONING_MODEL=openai/gpt-oss-120b
